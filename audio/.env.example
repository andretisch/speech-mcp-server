# Аудио-сервер STT+TTS
# Скопируй: cp .env.example .env

# Хост и порт
AUDIO_HOST=0.0.0.0
AUDIO_PORT=8000

# URL для curl-загрузки (transcribe_large_file_workflow, MCP)
# Если сервер доступен по другому адресу — укажи его
AUDIO_PUBLIC_URL=http://localhost:8000

# GPU (0, 1, …). Пусто — все
# CUDA_VISIBLE_DEVICES=

# STT (Whisper)
WHISPER_MODEL=base
# WHISPER_COMPUTE_TYPE=float16
# WHISPER_PRELOAD=0
# WHISPER_VAD=0

# Предзагрузка
# PRELOAD_ALL=0
# VAD_PRELOAD=0
# SPK_PRELOAD=0
# SILERO_PRELOAD=0

# Diarization
# DIARIZATION=1

# VAD (Silero)
# VAD_THRESHOLD=0.5
# VAD_MIN_SPEECH_MS=250
# VAD_MIN_SILENCE_MS=120
# VAD_MERGE_GAP_SEC=0.25

# Speaker embeddings
# SPK_EMB_MODEL=speechbrain/spkrec-ecapa-voxceleb
# SPK_MIN_CHUNK_SEC=1.0
# SPK_CLUSTER_THRESHOLD=0.7
# SPK_MERGE_GAP_SEC=0.4

# TTS (Silero)
# SILERO_LANG=ru
# SILERO_MODEL=v5_ru
# SILERO_SPEAKER=xenia
# SILERO_EN_LANG=en
# SILERO_EN_MODEL=lj_16khz
# SILERO_SAMPLE_RATE=48000
# SILERO_MAX_CHARS=5000
# TTS_PREPROCESS=1
# TTS_NUMBERS=1
# TTS_ABBR=1
# TTS_SPECIAL=1
# TTS_PAUSES=1
